# Phase 2 local Docker Compose defaults.
# These values are intentionally public, local-only convenience defaults. They are not secrets,
# must never be used outside local development, and may be copied to an untracked .env file to
# override ports or local values. Never commit production credentials, tokens, connection strings,
# or personal data.


OPENAI_API_KEY=secret

# Recommended model defaults for Phase 15–16
NORDIC_API_AI_PROVIDER=openai
NORDIC_API_OPENAI_CHAT_MODEL=gpt-5.4-mini
NORDIC_API_OPENAI_STRONG_MODEL=gpt-5.5
NORDIC_API_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
NORDIC_API_OPENAI_REASONING_EFFORT=low
NORDIC_API_OPENAI_TIMEOUT_SECONDS=30

COMPOSE_PROJECT_NAME=nordic-regulated-ai
APP_ENV=development


# Loopback-only host ports. Change the *_HOST_PORT values in an untracked .env file if a port is in use.
WEB_HOST_PORT=3000
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
AZURITE_BLOB_HOST_PORT=10000

# Compose service DNS names and internal ports. Containers must use these names, never localhost.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
AZURITE_HOST=azurite
AZURITE_BLOB_PORT=10000

# Deliberately non-production local database values.
POSTGRES_DB=nordic_local
POSTGRES_USER=nordic_local
POSTGRES_PASSWORD=local-postgres-password-not-for-production

# Azurite (local Azure Blob Storage emulator) values and the empty container provisioned by azurite-init.
# AccountName/AccountKey are Azurite's well-known public development credentials, never production secrets.
AZURITE_ACCOUNT_NAME=devstoreaccount1
AZURITE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
AZURITE_CONTAINER=nordic-local

# Optional API application settings (Phase 3). The API reads these from its process
# environment using the NORDIC_API_ prefix; when unset, the safe defaults shown here
# are used. They contain no secrets. Database sessions and Alembic derive their local
# Compose connection from the POSTGRES_* values above. An operator may instead provide
# NORDIC_API_DATABASE_URL as a secret async SQLAlchemy URL; do not commit it here.
# NORDIC_API_ENVIRONMENT=local            # local | test | staging | production
# NORDIC_API_LOG_LEVEL=info               # debug | info | warning | error | critical
# NORDIC_API_LOG_FORMAT=console           # console | json
# NORDIC_API_METRICS_ENABLED=true          # local-only Prometheus /metrics endpoint
# NORDIC_API_OTLP_ENDPOINT=                # optional internal OTLP HTTP collector base URL
# NORDIC_API_OTLP_EXPORT_TIMEOUT_SECONDS=5
# NORDIC_API_API_PREFIX=/api              # mount prefix for product route groups
# NORDIC_API_ENABLE_DOCS=true             # serve /docs, /redoc, /openapi.json locally
# CORS stays disabled unless exact browser origins are configured. For a separate web/API
# deployment, provide JSON arrays through untracked environment configuration; wildcards are rejected.
# NORDIC_API_CORS_ALLOWED_ORIGINS=["https://app.example.invalid"]
# NORDIC_API_CSRF_TRUSTED_ORIGINS=["https://app.example.invalid"]
# NORDIC_API_REQUEST_ID_HEADER=X-Request-ID
# NORDIC_API_DATABASE_POOL_SIZE=5
# NORDIC_API_DATABASE_MAX_OVERFLOW=10
# Authentication/session configuration (Phase 6). Redis defaults to the local Compose service when
# NORDIC_API_REDIS_URL is not supplied; do not commit a Redis URL with credentials.
# NORDIC_API_SESSION_COOKIE_NAME=nordic_session
# NORDIC_API_SESSION_TTL_SECONDS=28800
# NORDIC_API_SESSION_COOKIE_SAMESITE=lax
# NORDIC_API_PASSWORD_MIN_LENGTH=12
# NORDIC_API_PASSWORD_MAX_LENGTH=512
# NORDIC_API_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# NORDIC_API_LOGIN_RATE_LIMIT_EMAIL_ATTEMPTS=5
# NORDIC_API_LOGIN_RATE_LIMIT_ORIGIN_ATTEMPTS=20
# NORDIC_API_RATE_LIMIT_KEY_SECRET=             # inject outside local development; never commit
# Protected route limits use HMAC-derived user/client keys and fail closed if Redis is unavailable.
# NORDIC_API_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=900
# NORDIC_API_UPLOAD_RATE_LIMIT_USER_ATTEMPTS=10
# NORDIC_API_UPLOAD_RATE_LIMIT_ORIGIN_ATTEMPTS=40
# NORDIC_API_RETRIEVAL_RATE_LIMIT_WINDOW_SECONDS=900
# NORDIC_API_RETRIEVAL_RATE_LIMIT_USER_ATTEMPTS=60
# NORDIC_API_RETRIEVAL_RATE_LIMIT_ORIGIN_ATTEMPTS=240
# NORDIC_API_WORKFLOW_RATE_LIMIT_WINDOW_SECONDS=900
# NORDIC_API_WORKFLOW_RATE_LIMIT_USER_ATTEMPTS=10
# NORDIC_API_WORKFLOW_RATE_LIMIT_ORIGIN_ATTEMPTS=40
# Secure document upload/storage configuration (Phase 10). Compose derives the private Azurite
# connection from the public local-development account values above; production must inject its
# own NORDIC_API_OBJECT_STORAGE_CONNECTION_STRING outside source control.
# NORDIC_API_DOCUMENT_UPLOAD_MAX_BYTES=26214400  # 25 MiB hard cap
# NORDIC_API_DOCUMENT_UPLOAD_MULTIPART_OVERHEAD_BYTES=1048576
# NORDIC_API_OBJECT_STORAGE_CONTAINER=nordic-local
# NORDIC_API_OBJECT_STORAGE_CONNECTION_STRING=    # inject outside local development; never commit
# NORDIC_API_OBJECT_STORAGE_HEALTH_URL=            # deployed non-secret endpoint; local derives Azurite
# Background document parsing (Phase 11). Values are bounded conservatively; the worker only
# submits document UUIDs to Redis and reads metadata/private objects itself.
# NORDIC_API_DOCUMENT_PARSER_MAX_INPUT_BYTES=26214400
# NORDIC_API_DOCUMENT_PARSER_MAX_EXTRACTED_CHARACTERS=2000000
# NORDIC_API_DOCUMENT_PARSER_MAX_SECTIONS=10000
# NORDIC_API_DOCUMENT_PARSER_TASK_TIMEOUT_SECONDS=120
# NORDIC_API_DOCUMENT_PARSER_TASK_MAX_RETRIES=3
# NORDIC_API_DOCUMENT_PARSER_WORKER_CONCURRENCY=1
# NORDIC_API_DOCUMENT_PARSER_RECONCILIATION_INTERVAL_SECONDS=60
# NORDIC_API_DOCUMENT_PARSER_PROCESSING_LEASE_SECONDS=300
# NORDIC_API_DOCUMENT_LANGUAGE_CONFIDENCE_THRESHOLD=0.8
# Chunking and embeddings (Phase 12). Configure an approved provider explicitly for normal use.
# The deterministic provider is permitted only for clearly labelled local/test plumbing checks; it
# produces non-semantic vectors and must never be treated as retrieval-quality validation.
# NORDIC_API_EMBEDDING_PROVIDER=openai                 # openai | azure_openai | deterministic
# NORDIC_API_EMBEDDING_API_KEY=                        # inject outside source control
# NORDIC_API_EMBEDDING_AZURE_ENDPOINT=                 # inject outside source control
# NORDIC_API_EMBEDDING_AZURE_API_VERSION=2024-02-01
# NORDIC_API_EMBEDDING_MODEL=text-embedding-3-small    # Azure: deployment name
# NORDIC_API_EMBEDDING_TOKENIZER_ENCODING=cl100k_base
# NORDIC_API_EMBEDDING_CONFIGURATION_VERSION=v1
# NORDIC_API_DOCUMENT_CHUNK_MAX_TOKENS=512
# NORDIC_API_DOCUMENT_CHUNK_OVERLAP_TOKENS=64
# NORDIC_API_DOCUMENT_CHUNK_MAXIMUM_COUNT=10000
# NORDIC_API_EMBEDDING_BATCH_SIZE=32
# NORDIC_API_EMBEDDING_TIMEOUT_SECONDS=30
# NORDIC_API_DOCUMENT_INDEXER_TASK_TIMEOUT_SECONDS=300
# NORDIC_API_DOCUMENT_INDEXER_TASK_MAX_RETRIES=3
# NORDIC_API_DOCUMENT_INDEXER_RECONCILIATION_INTERVAL_SECONDS=60
# NORDIC_API_DOCUMENT_INDEXER_PROCESSING_LEASE_SECONDS=600
# Retrieval (Phase 13). Candidate pool sizes are server-owned and must remain at
# least as large as the maximum public result limit.
# NORDIC_API_RETRIEVAL_DEFAULT_RESULT_LIMIT=10
# NORDIC_API_RETRIEVAL_MAX_RESULT_LIMIT=20
# NORDIC_API_RETRIEVAL_SEMANTIC_CANDIDATE_LIMIT=50
# NORDIC_API_RETRIEVAL_KEYWORD_CANDIDATE_LIMIT=50
# NORDIC_API_RETRIEVAL_RANK_FUSION_CONSTANT=60
# NORDIC_API_RETRIEVAL_MAX_QUERY_CHARACTERS=2000
# NORDIC_API_RETRIEVAL_MAX_DOCUMENT_SELECTIONS=20
# NORDIC_API_RETRIEVAL_MAX_EXCERPT_CHARACTERS=1200
# Explicit source context (Phase 14) is bounded server-side and never accepts a
# browser-provided range or byte limit.
# NORDIC_API_DOCUMENT_CONTEXT_MAX_CHARACTERS=1200
# Direct RAG answers (Phase 15). This API-only capability uses current approved
# sources only and needs a real configured completion provider for a manual answer.
# Never place a real key or endpoint in this tracked example file.
# NORDIC_API_RAG_COMPLETION_PROVIDER=openai              # openai | azure_openai | deterministic (local/test only)
# NORDIC_API_RAG_COMPLETION_API_KEY=                      # inject outside source control
# NORDIC_API_RAG_COMPLETION_AZURE_ENDPOINT=               # Azure only; inject outside source control
# NORDIC_API_RAG_COMPLETION_AZURE_API_VERSION=2024-02-01
# NORDIC_API_RAG_COMPLETION_MODEL=gpt-4.1-mini             # Azure: deployment name
# NORDIC_API_RAG_COMPLETION_TIMEOUT_SECONDS=30
# NORDIC_API_RAG_COMPLETION_MAX_OUTPUT_TOKENS=800
# NORDIC_API_RAG_MAX_ANSWER_CHARACTERS=8000
# NORDIC_API_RAG_MAX_EVIDENCE_SOURCES=5
# NORDIC_API_RAG_MAX_EVIDENCE_CHARACTERS=5000
# NORDIC_API_RAG_MIN_EVIDENCE_SOURCES=1
# NORDIC_API_RAG_MIN_EVIDENCE_CHARACTERS=200
# NORDIC_API_RAG_INPUT_PRICE_PER_MILLION=                 # pair with output rate outside local/test
# NORDIC_API_RAG_OUTPUT_PRICE_PER_MILLION=
# Agent orchestration (Phases 16–17). These settings use their own prefix and
# are server-owned; never expose them to the browser or commit a key/endpoint.
# The deterministic provider is local/test fixture plumbing only, not model-quality evidence.
# NORDIC_AGENT_ENVIRONMENT=local                         # local | test | staging | production
# NORDIC_AGENT_PROVIDER=deterministic                    # openai | azure_openai | deterministic
# NORDIC_AGENT_MODEL=gpt-4.1-mini                         # Azure: deployment name
# NORDIC_AGENT_API_KEY=                                  # inject outside source control
# NORDIC_AGENT_AZURE_ENDPOINT=                           # Azure only; inject outside source control
# NORDIC_AGENT_AZURE_API_VERSION=2024-02-01
# NORDIC_AGENT_TIMEOUT_SECONDS=30
# NORDIC_AGENT_MAX_OUTPUT_TOKENS=800
# NORDIC_AGENT_NODE_MAXIMUM_RETRIES=1
# NORDIC_AGENT_INTAKE_CONFIDENCE_THRESHOLD=0.8
# NORDIC_AGENT_EVIDENCE_MAXIMUM_SOURCES=5
# NORDIC_AGENT_EVIDENCE_MAXIMUM_EXCERPT_CHARACTERS=5000
# NORDIC_AGENT_EVIDENCE_MINIMUM_SOURCES=1
# NORDIC_AGENT_EVIDENCE_MINIMUM_EXCERPT_CHARACTERS=200
# NORDIC_AGENT_EXTRACTION_CONFIDENCE_THRESHOLD=0.8
